MYSQL_ROOT_PASSWORD=troque_root
MYSQL_DATABASE=iot_db
MYSQL_USER=sentinela
MYSQL_PASSWORD=troque_senha

# Broker MQTT (EMQX) - obrigatório. Usuários criados na primeira subida:
#   plataforma  -> ingestor e API
#   dispositivo -> ESP32 (copie a mesma senha para MQTT_USER/MQTT_PASS do firmware/config.h)
# Para trocar depois de criado: Dashboard do EMQX > Access Control > Authentication > Users.
MQTT_PLATFORM_PASS=troque_senha_plataforma
MQTT_DEVICE_PASS=troque_senha_dispositivo
# Senha do usuário admin do dashboard do EMQX (http://localhost:18083) em instalação nova
EMQX_DASHBOARD_PASS=troque_senha_dashboard

# API v2 (app mobile e dashboard web)
# Chave para assinar os tokens de login. Gere uma longa e aleatória, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# true cria admin@, operator@ e viewer@sentinelacpd.demo com senha Sentinela123 (só para testes/apresentação)
DEMO_USERS=false
# Administrador criado na primeira subida (opcional). Outros usuários: api/criar_usuario.py
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Segundos sem leitura para o app mostrar "desatualizado" e para abrir o alerta telemetry_stale
STALE_AFTER_S=15
STALE_ALERT_S=60
# Origens do dashboard web separadas por vírgula (vazio = qualquer origem, só na rede de testes)
CORS_ORIGINS=
# OTA: endereço que o ESP32 usa para baixar o firmware da API. Vazio = usa o IP do broker
# gravado no firmware (MQTT_BROKER) e a porta 8000, o que serve na bancada.
OTA_BASE_URL=

# API v1 (rotas /api/...): exigem o login da v2 ou, se preencher API_KEY, o cabeçalho X-API-Key.
API_KEY=
TEMP_LIMITE=35
ONLINE_TIMEOUT_S=30

# Alertas por Telegram (crie o bot com @BotFather; NUNCA publique o token)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
OFFLINE_S=60
