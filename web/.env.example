# true = dados fictícios (modo demonstração); false = API real do Cloud
VITE_USE_MOCKS=true
# Caminho da API. Com o `npm run dev`, /api/v2 é repassado para VITE_PROXY_TARGET.
VITE_API_BASE=/api/v2
# Endereço da API do Cloud usado pelo proxy do Vite em desenvolvimento
VITE_PROXY_TARGET=http://localhost:8000
