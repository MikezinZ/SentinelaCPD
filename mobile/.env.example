EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_USE_MOCKS=true
EXPO_PUBLIC_ENABLE_DEV_MENU=true
# Chave opcional e pública no bundle. Para chave sensível, use Ajustes/SecureStore.
EXPO_PUBLIC_API_KEY=
# Rotas adotadas; ajuste conforme o OpenAPI da sua API Cloud.
EXPO_PUBLIC_STATUS_PATH=/status/cpd
EXPO_PUBLIC_TELEMETRIA_PATH=/telemetria
EXPO_PUBLIC_INCIDENTES_PATH=/incidentes
EXPO_PUBLIC_DISPOSITIVOS_PATH=/dispositivos
