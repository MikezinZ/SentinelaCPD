{
  "expo": {
    "name": "SentinelaCPD",
    "slug": "sentinelacpd-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sentinelacpd",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.sentinelacpd.mobile"
    },
    "android": {
      "package": "br.edu.sentinelacpd.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

